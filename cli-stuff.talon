

# NPM
install packages:
    insert("npm i")
    key(enter)

update packages:
    insert("npm run update")

NPM view:
    insert("npm view ")

NPM view version:
    insert("npm view  version --json")
    key(left:15)

NPM view versions:
    insert("npm view  version --json")
    key(left:16)

NPM view per dips:
    insert("npm view  peerDependencies --json")
    key(left:25)
    




# NVM
NVM version:
    insert("nvm -v")
    key(left:25)

NVM list:
    insert("nvm list")
    key(enter)

NVM list available:
    insert("nvm list available")
    key(enter)


NVM use:
    insert("nvm use")


NVM install:
    insert("nvm install")


NVM uninstall:
    insert("nvm uninstall")

# yarn commands 
yarn install:    
    insert("yarn install")
    key(enter)

yarn start:
    insert("yarn start")
    key(enter)

yarn build:
    insert("yarn build")
    key(enter)

yarn lint:
    insert("yarn lint")
    key(enter)

yarn test:
    insert("yarn test")